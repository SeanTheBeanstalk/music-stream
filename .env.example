# Optional absolute path to yt-dlp. Defaults to yt-dlp on PATH.
YT_DLP_PATH=

# Default catalog storefront: US, SG, GB, AU, CA, JP, DE, FR, IN.
ITUNES_COUNTRY=US
# Maximum simultaneous server workers across all app instances.
# Static allocation of the shared upstream request budget; see README before scaling.
ITUNES_WORKER_COUNT=1

# Optional Postgres connection URL (server-only). Apply database/migrations first.
# Leave blank to keep provider-only search and playback.
# Library accounts, likes, and playlists require this plus migrations 0001–0003.
DATABASE_URL=

# Serve ready private R2 assets via /api/stream; requires DATABASE_URL and R2 below.
# This enables reads independently of automatic cache fills.
R2_PLAYBACK_ENABLED=false

# Enqueue audio on playback and serve completed assets. Run pnpm cache:worker.
# Requires DATABASE_URL, migrations 0001 + 0002, and R2 credentials below.
AUDIO_CACHE_ENABLED=false
AUDIO_CACHE_MAX_BYTES=8000000000
AUDIO_CACHE_MAX_FILE_BYTES=128000000
AUDIO_CACHE_RETENTION_DAYS=30
# Per worker process, 1-4; budget reservations are coordinated across processes.
AUDIO_CACHE_WORKER_CONCURRENCY=1
# ffprobe is required by the cache worker to verify downloaded media.
# Defaults to ffprobe on PATH; may be an absolute executable path.
FFPROBE_PATH=

# Cloudflare R2 (server-only; needed for playlist covers, R2 playback, or storage helpers/CLI).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public bucket/custom domain base URL; private signed URLs do not use it.
# The app currently keeps delivery private and does not read this variable.
R2_PUBLIC_URL=
